# Copie este arquivo para .env.local com: npm run setup
# Os valores abaixo são um exemplo para o seu computador.
# Eles NÃO funcionam em produção (next start nem Vercel).
# Gere outros antes de publicar. O passo a passo está no README.

# Endereço público do site. No computador, deixe assim.
# Na Vercel, troque pelo domínio real, com https, sem barra no final.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Caminho secreto da área de fotos. Só letras minúsculas, números e hífen.
# Mínimo de 17 caracteres. Não use uma palavra óbvia.
# Novo caminho: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ADMIN_PATH=e41460582e2f26f2dd93fcd948f5ecdc

# Hash da senha, nunca a senha em texto puro.
# A senha DESTE exemplo local é: churrasco-local-apenas
# Para outra senha: npm run admin:hash
ADMIN_PASSWORD=scrypt:760ae65514b609d0e7c7bb2263b79d84:b75d1ddec50b5ef8e777d4435e479e19e095c7e52600d953254d00c9c467cbefc17c3eaa3c3270a0ae18581ec6a4738059d7e55652c8e80b55cb692c0c05d655

# Segredo que assina o cookie de login. Mínimo de 32 caracteres.
# Novo segredo: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=LJ2tQJMlZSPxPfq4A3aWhxBgdLwuTnSGJ6LGcHX1WtcmTNsB

# Deixe vazio no computador. As fotos ficam na pasta data/photos.
# Na Vercel, cole o token do Blob store (BLOB_READ_WRITE_TOKEN).
BLOB_READ_WRITE_TOKEN=
